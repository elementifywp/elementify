{
	"name": "elementify",
	"version": "1.0.0",
	"description": "Elementify is a sleek and minimalist WordPress blog theme.",
	"author": "Elementify Themes",
	"license": "GPL-2.0-or-later",
	"private": true,
	"keywords": [
		"wordpress",
		"wordpress-theme",
		"blog",
		"elementify"
	],
	"homepage": "https://github.com/elementifywp/elementify#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/elementifywp/elementify.git"
	},
	"bugs": {
		"url": "https://github.com/elementifywp/elementify/issues"
	},
	"engines": {
		"node": "^22.22.2 || >=24.15.0"
	},
	"packageManager": "pnpm@12.8.1",
	"files": [
		"*.php",
		"style.css",
		"screenshot.png",
		"readme.txt",
		"wpml-config.xml",
		"assets/build",
		"inc",
		"languages",
		"template-parts"
	],
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@wordpress/babel-preset-default": "^8.56.0",
		"@wordpress/browserslist-config": "^6.37.0",
		"@wordpress/e2e-test-utils-playwright": "^2.1.0",
		"@wordpress/env": "^11.16.0",
		"@wordpress/postcss-plugins-preset": "^5.56.0",
		"@wordpress/scripts": "^36.0.0",
		"@wordpress/stylelint-config": "^26.0.0",
		"copy-webpack-plugin": "^13.0.1",
		"cssnano": "^6.1.2",
		"webpack-remove-empty-scripts": "^1.1.1"
	},
	"scripts": {
		"build": "wp-scripts build --config ./webpack.config.js",
		"start": "wp-scripts start --config ./webpack.config.js",
		"clean": "rm -rf assets/build",
		"format": "wp-scripts format ./assets/src ./tests",
		"lint": "pnpm run --parallel \"/^lint:(js|css|pkg|php)$/\"",
		"lint:js": "wp-scripts lint-js ./assets/src ./tests *.config.js",
		"lint:js:fix": "pnpm run lint:js --fix",
		"lint:css": "wp-scripts lint-style \"assets/src/**/*.css\"",
		"lint:css:fix": "pnpm run lint:css --fix",
		"lint:pkg": "wp-scripts lint-pkg-json .",
		"lint:php": "composer run lint",
		"lint:php:fix": "composer run format",
		"analyze:php": "composer run phpstan",
		"i18n:pot": "wp i18n make-pot . languages/elementify.pot --domain=elementify --exclude=assets/build,node_modules,vendor,tests",
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:e2e": "wp-scripts test-playwright",
		"test:e2e:ui": "wp-scripts test-playwright --ui",
		"release": "pnpm run clean && pnpm run build && pnpm run i18n:pot && wp-scripts plugin-zip"
	}
}
