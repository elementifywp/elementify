{
	"name": "elementify",
	"version": "1.0.0",
	"description": "Elementify is a sleek and minimalist WordPress blog theme.",
	"author": "Elementify Themes",
	"license": "GPL-2.0-or-later",
	"private": true,
	"keywords": [
		"wordpress",
		"wordpress-theme",
		"blog",
		"elementify"
	],
	"homepage": "https://github.com/elementifywp/elementify#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/elementifywp/elementify.git"
	},
	"bugs": {
		"url": "https://github.com/elementifywp/elementify/issues"
	},
	"engines": {
		"node": ">=20.6.1"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.8.1",
		"autoprefixer": "^10.4.20",
		"babel-loader": "^10.0.0",
		"clean-webpack-plugin": "^4.0.0",
		"copy-webpack-plugin": "^13.0.0",
		"cross-env": "^7.0.3",
		"css-minimizer-webpack-plugin": "^7.0.0",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-webpack-plugin": "^4.2.0",
		"grunt": "^1.6.1",
		"grunt-checktextdomain": "^1.0.1",
		"grunt-cli": "^1.4.3",
		"grunt-contrib-clean": "^2.0.1",
		"grunt-contrib-compress": "^2.0.0",
		"grunt-contrib-copy": "^1.0.0",
		"grunt-wp-i18n": "^1.0.3",
		"grunt-wp-readme-to-markdown": "^2.1.0",
		"jest-silent-reporter": "^0.6.0",
		"lint-staged": "^15.4.3",
		"mini-css-extract-plugin": "^2.9.2",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.4.49",
		"postcss-loader": "^8.1.1",
		"postcss-preset-env": "^10.1.3",
		"rtlcss-webpack-plugin": "^4.0.7",
		"stylelint-webpack-plugin": "^5.0.1",
		"tailwindcss": "^3.4.15",
		"webpack-remove-empty-scripts": "^1.0.4"
	},
	"scripts": {
		"build:dev": "cross-env NODE_ENV=development npm-run-all 'build:!(dev|prod)'",
		"build:prod": "cross-env NODE_ENV=production npm-run-all 'build:!(dev|prod)'",
		"build:js": "npm run clean && wp-scripts build --experimental-modules",
		"build:pot": "grunt i18n",
		"start": "npm run clean && wp-scripts start --experimental-modules",
		"clean": "rm -rf assets/build/*",
		"lint:all": "npm-run-all --parallel lint:css lint:js lint:php lint:package-json",
		"lint:css": "wp-scripts lint-style ./assets/src",
		"lint:css:fix": "npm run lint:css -- --fix ./assets/src",
		"lint:js": "wp-scripts lint-js ./assets/src",
		"lint:js:fix": "npm run lint:js -- --fix ./assets/src",
		"lint:js:report": "npm run lint:js -- --output-file lint-js-report.json --format json .",
		"lint:php": "php vendor/bin/phpcs",
		"lint:php:fix": "php vendor/bin/phpcbf",
		"lint:package-json": "wp-scripts lint-pkg-json --ignorePath .gitignore",
		"lint:staged": "lint-staged",
		"release": "grunt release",
		"readme": "grunt readme",
		"precommit": "npm-run-all lint:css lint:js lint:php build:pot"
	},
	"browserslist": [
		"last 3 versions",
		"> 1%"
	]
}
