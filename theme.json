{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": true,
			"defaultPalette": false,
			"palette": [
				{
					"name": "Primary",
					"slug": "ele-primary",
					"color": "var(--ele-primary-color)"
				},
				{
					"name": "Primary Active",
					"slug": "ele-primary-active",
					"color": "var(--ele-primary-active)"
				},
				{
					"name": "Accent",
					"slug": "ele-accent",
					"color": "var(--ele-accent-color)"
				},
				{
					"name": "Accent Active",
					"slug": "ele-accent-active",
					"color": "var(--ele-accent-active)"
				},
				{
					"name": "Base",
					"slug": "ele-base",
					"color": "var(--ele-base-color)"
				},
				{
					"name": "Base 100",
					"slug": "ele-base-100",
					"color": "var(--ele-base-100)"
				},
				{
					"name": "Base 200",
					"slug": "ele-base-200",
					"color": "var(--ele-base-200)"
				},
				{
					"name": "Base 300",
					"slug": "ele-base-300",
					"color": "var(--ele-base-300)"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"layout": {
			"contentSize": "var(--ele-container-max-width)",
			"wideSize": "100%",
			"fullSize": "none"
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"units": ["px", "em", "rem", "%", "vh", "vw"]
		},
		"typography": {
			"customFontSize": true,
			"customLineHeight": true,
			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "14px"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "16px"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "24px"
				},
				{
					"name": "Extra Large",
					"slug": "x-large",
					"size": "30px"
				},
				{
					"name": "XX-Large",
					"slug": "xx-large",
					"size": "34px"
				}
			]
		}
	},
	"styles": {
		"spacing": {
			"blockGap": "var(--ele-content-spacing)"
		},
		"elements": {
			"link": {
				"typography": {
					"textDecoration": "none"
				}
			},
			"button": {
				"spacing": {
					"padding": false
				},
				"border": {
					"width": false
				},
				"color": {
					"background": false,
					"text": false
				},
				"typography": {
					"fontFamily": false,
					"fontSize": false,
					"lineHeight": false,
					"textDecoration": false
				}
			}
		}
	}
}