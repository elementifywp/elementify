{
	"$schema": "https://schemas.wp.org/wp/6.4/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"color": {
			"custom": true,
			"customGradient": true,
			"defaultGradients": false,
			"defaultPalette": false,
			"defaultDuotone": false,
			"link": true,
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "var(--ele-primary-color, #03f)"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "var(--ele-secondary-color, #335cff)"
				},
				{
					"name": "Heading",
					"slug": "heading",
					"color": "var(--ele-heading-color, #181f28)"
				},
				{
					"name": "Text",
					"slug": "text",
					"color": "var(--ele-text-color, #334155)"
				},
				{
					"name": "Border",
					"slug": "base-300",
					"color": "var(--ele-base-300, #e2e8f0)"
				},
				{
					"name": "Subtle background",
					"slug": "base-200",
					"color": "var(--ele-base-200, #f1f5f9)"
				},
				{
					"name": "Background",
					"slug": "base-100",
					"color": "var(--ele-base-100, #fff)"
				}
			]
		},
		"layout": {
			"contentSize": "var(--ele-container-narrow-width, 750px)",
			"wideSize": "var(--ele-container-max-width, 1280px)"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Soft",
					"slug": "soft",
					"shadow": "var(--ele-box-shadow, 0 5px 16px 0 #e2e8f0)"
				}
			]
		},
		"spacing": {
			"blockGap": null,
			"margin": true,
			"padding": true,
			"units": [ "px", "em", "rem", "%", "vh", "vw" ]
		},
		"typography": {
			"customFontSize": true,
			"dropCap": true,
			"fluid": false,
			"lineHeight": true,
			"fontFamilies": [
				{
					"name": "System sans-serif",
					"slug": "system-sans",
					"fontFamily": "var(--ele-font-family, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\")"
				},
				{
					"name": "Monospace",
					"slug": "monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "0.875rem"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1rem"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.5rem"
				},
				{
					"name": "Extra large",
					"slug": "x-large",
					"size": "2rem"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base-200)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--heading)"
				},
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "2em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "1.5em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.17em"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1em"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "0.83em"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "0.67em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": false
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				}
			},
			"button": {
				"spacing": {
					"padding": false
				},
				"border": {
					"width": false
				},
				"color": {
					"background": false,
					"text": false
				},
				"typography": {
					"fontFamily": false,
					"fontSize": false,
					"lineHeight": false,
					"textDecoration": false
				}
			}
		},
		"blocks": {
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--monospace)"
				}
			}
		}
	}
}
