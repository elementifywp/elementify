{
	"name": "elementifywp/elementify",
	"type": "wordpress-theme",
	"description": "Elementify is a sleek and minimalist WordPress blog theme.",
	"homepage": "https://github.com/elementifywp/elementify",
	"license": "GPL-2.0-or-later",
	"support": {
		"issues": "https://github.com/elementifywp/elementify/issues",
		"source": "https://github.com/elementifywp/elementify"
	},
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"phpcompatibility/phpcompatibility-wp": "^3.0",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"platform": {
			"php": "7.4.33"
		},
		"sort-packages": true
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"scripts": {
		"lint": [
			"@lint:syntax",
			"@lint:phpcs"
		],
		"lint:syntax": "parallel-lint --exclude .git --exclude vendor --exclude node_modules .",
		"lint:phpcs": "phpcs",
		"format": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=2G"
	}
}
